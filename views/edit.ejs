<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="form-card">
        <h1>Edit your Post</h1>

        <div class="user-badge">
            <p><strong>Post ID:</strong> <%= post.id %></p>
            <% if (post.image) { %>
            <img src="<%= post.image %>" alt="Post image" class="post-image">

           <form action="/posts/<%= post.id %>/image?_method=DELETE" method="post" class="delete-form">
        <div class="form-actions">
            <button class="btn-primary" type="submit">Remove image</button>
        </div>
    </form>
            <% } %>
    

            
            <p><strong>Author:</strong> @<%= post.username %></p>
        </div>

        <form action="/posts/<%= post.id %>?_method=PATCH" method="post" class="post-form">
            <div class="form-group">
                <label for="content">Post Content</label>
                <textarea name="content" id="content" rows="6" required><%= post.content %></textarea>
            </div>

            <div class="form-actions">
                <a href="/posts" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary">Submit</button>
            </div>
        </form>
    </div>
</body>
</html>